{
  "templates": [
    {
      "categories": [
        "Downloaders",
        "Tools"
      ],
      "description": "Multi-protocol download manager with a web UI. Handles HTTP/HTTPS, FTP, BitTorrent (DHT/magnet), eD2K/Kad, HLS and DASH, with dynamic file segmentation, token-bucket rate limiting and SQLite-backed resume. Exposes an aria2-compatible JSON-RPC API.",
      "env": [
        {
          "default": "UTC",
          "label": "Timezone",
          "name": "TZ"
        }
      ],
      "image": "ghcr.io/zerx-lab/fluxdown-server:0.2.3",
      "logo": "https://cdn.jsdelivr.net/gh/zerx-lab/FluxDown@main/assets/logo/fluxdown_logo.svg",
      "maintainer": "zerx-lab",
      "name": "fluxdown",
      "note": "First launch prints a one-time admin token to the container log: <code>docker logs &lt;container&gt; 2>&amp;1 | grep -i token</code>. The management API and the built-in MCP endpoint both require this token. Web UI is served on port 17800.",
      "platform": "linux",
      "ports": [
        "17800:17800/tcp"
      ],
      "restart_policy": "unless-stopped",
      "title": "FluxDown",
      "type": 1,
      "volumes": [
        {
          "container": "/data"
        },
        {
          "container": "/root/Downloads"
        }
      ]
    },
    {
      "categories": [
        "Media",
        "Books"
      ],
      "description": "A free and open source comics, manga, and digital book server with OPDS support. Source: https://github.com/stumpapp/stump",
      "env": [
        {
          "default": "1000",
          "label": "PUID",
          "name": "PUID"
        },
        {
          "default": "1000",
          "label": "PGID",
          "name": "PGID"
        },
        {
          "default": "/config",
          "label": "STUMP_CONFIG_DIR",
          "name": "STUMP_CONFIG_DIR"
        }
      ],
      "image": "aaronleopold/stump:latest",
      "logo": "https://avatars.githubusercontent.com/u/114969632",
      "name": "stump",
      "platform": "linux",
      "ports": [
        "10801:10801/tcp"
      ],
      "restart_policy": "unless-stopped",
      "title": "Stump",
      "type": 1,
      "volumes": [
        {
          "container": "/config"
        },
        {
          "container": "/data"
        }
      ]
    },
    {
      "categories": [
        "Gaming",
        "Other"
      ],
      "description": "Dedicated Terraria server in a Docker container. Source: https://github.com/hexlo/terraria-server-docker",
      "env": [
        {
          "default": "changeme123",
          "label": "Server password",
          "name": "SERVER_PASSWORD"
        },
        {
          "default": "Welcome to my server!",
          "label": "Message of the day",
          "name": "MOTD"
        }
      ],
      "logo": "https://avatars.githubusercontent.com/u/584474",
      "name": "terraria-server",
      "platform": "linux",
      "repository": {
        "stackfile": "sources/stacks/terraria-server.yml",
        "url": "https://github.com/lissy93/portainer-templates"
      },
      "title": "Terraria Server",
      "type": 3
    },
    {
      "categories": [
        "Gaming",
        "Other"
      ],
      "description": "Valheim dedicated gameserver in Docker with full modding support. Source: https://github.com/lloesche/valheim-server-docker",
      "env": [
        {
          "default": "My Server",
          "label": "Server name (shown in the browser)",
          "name": "SERVER_NAME"
        },
        {
          "default": "Dedicated",
          "label": "World/save name",
          "name": "WORLD_NAME"
        },
        {
          "default": "changeme123",
          "label": "Server password (minimum 5 characters)",
          "name": "SERVER_PASS"
        },
        {
          "default": "Etc/UTC",
          "label": "Timezone",
          "name": "TZ"
        }
      ],
      "logo": "https://avatars.githubusercontent.com/u/82116562",
      "name": "valheim-server-docker",
      "platform": "linux",
      "repository": {
        "stackfile": "sources/stacks/valheim-server-docker.yml",
        "url": "https://github.com/lissy93/portainer-templates"
      },
      "title": "Valheim Server",
      "type": 3
    }
  ],
  "version": "3"
}
